<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 🌐 インターネット通信を許可（Firebase接続に必須） -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- 🔑 生体認証（指紋・顔認証）の使用を許可 -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!-- 🔋 スマホ起動時の自動起動（再起動対策）を許可 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- 🛠️ バックグラウンドでの常時監視サービスを許可 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- 🔔 Android 13以降で常時監視通知を出すために必須の権限 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 🌟 追加：裏に隠れている監視サービスから画面を強制起動するために必須の権限 -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- 🟢 tools:ignore を追加して、警告を無視するように指示します -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />


    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.DOPAXlimit">

        <!-- メイン画面（履歴画面から完全に隠す設定を追加） -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.DOPAXlimit"
            android:excludeFromRecents="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 🛡️ 端末管理者設定（Device Owner）用のレシーバー -->
        <receiver
            android:name=".MyDeviceAdminReceiver"
            android:label="DOPAX Limit Admin"
            android:permission="android.permission.BIND_DEVICE_ADMIN"
            android:exported="true">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin_receiver" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <!-- 🚀 再起動を検知してアプリを自動起動するためのレシーバー -->
        <receiver
            android:name=".BootReceiver"
            android:exported="true" >
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- 🌟 バックグラウンドで常時制限をチェックするサービス -->
        <service
            android:name=".LimitMonitorService"
            android:foregroundServiceType="specialUse"
            android:exported="false" />

        <!-- 🌟 PC不要モード用のユーザー補助サービス -->
        <service
            android:name=".DopaxAccessibilityService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>
    </application>

</manifest>
